# Copy to env.local and `source` it, or pass these as KEY=VALUE to submit.sh.
# Everything has a working default; this file documents what is tunable.

NS=cms-ml
BRANCH=ErwinParTCluster

# :latest is a MOVING TAG - two runs a week apart may differ. For a run you
# intend to cite, resolve the digest once and pin it:
#   kubectl -n cms-ml get pod vleept-probe -o jsonpath='{.status.containerStatuses[0].imageID}'
IMAGE=gitlab-registry.nrp-nautilus.io/jmduarte/hbb_interaction_network:latest

MODEL=ErwinParTv2          # ParT | ErwinParTv2 | ParTNoPairs | PN | PFN | PCNN | ...
FEATURE=full               # kin | kinpid | full
TAG=v2-10pct               # becomes part of the run id and the job name

# ---- SCOPE -----------------------------------------------------------------
# 10% of JetClass. DATA_FRACTION caps what each epoch reads from every file
# (class balance preserved, redrawn per epoch for train/val, deterministic for
# test). SAMPLES_PER_EPOCH caps compute so an epoch is about one pass over that
# 10% rather than ten passes over it. Raise only deliberately.
DATA_FRACTION=0.1
SAMPLES_PER_EPOCH=1024000
SAMPLES_PER_EPOCH_VAL=128000
EPOCHS=50

DEADLINE=172800            # activeDeadlineSeconds; 48h
EXTRA_ARGS=                # forwarded verbatim, e.g. "-o readout fine"
